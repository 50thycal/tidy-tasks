{
  "endpoint": "/api/ai/prioritize_tasks",
  "method": "POST",
  "headers": {
    "Content-Type": "application/json",
    "X-No-Train": "true"
  },
  "request": {
    "date": "2025-11-03",
    "timezone": "America/Phoenix",
    "energy": "med",
    "max_focus_minutes": 240,
    "calendar_windows": [
      { "start": "2025-11-03T09:00:00-07:00", "end": "2025-11-03T11:30:00-07:00", "type": "free" },
      { "start": "2025-11-03T13:30:00-07:00", "end": "2025-11-03T16:00:00-07:00", "type": "free" }
    ],
    "tasks": [
      {
        "id": "t_weekly_email",
        "title": "Prep weekly progress email",
        "status": "active",
        "importance": 60,
        "effort_min": 30,
        "energy": "low",
        "due_at": "2025-11-03T16:00:00-07:00",
        "project": "Account Ops",
        "tags": ["email", "report"]
      },
      {
        "id": "t_email_brian",
        "title": "Email Brian about easement language",
        "status": "active",
        "importance": 78,
        "effort_min": 30,
        "energy": "low",
        "due_at": "2025-11-04T17:00:00-07:00",
        "project": "Shawnee-Walker Segment 1",
        "tags": ["email", "client", "easement"]
      },
      {
        "id": "t_helical_calc",
        "title": "Update helical pile calc sheet for Fulton Co.",
        "status": "active",
        "importance": 82,
        "effort_min": 120,
        "energy": "high",
