        "energy": "med",
        "due_at": "2025-11-05T09:00:00-07:00",
        "project": "Shawnee-Walker Segment 1",
        "tags": ["review", "client"]
      }
    ]
  },
  "system_prompt": "You are a planning assistant. For each task, compute priority_score (0–100) using: 40% urgency (time to due/scheduled), 40% importance, 10% momentum (same project streak: +0–20), 10% fit (alignment with energy + available windows: +0–20). Apply overload penalty if planned focus would exceed max_focus_minutes. Assign bucket ∈ {Now, Next, Later, Backlog}. Return an array of {id, priority_score, bucket, rationale}. Keep total planned (bucket=Now) ≤ max_focus_minutes. Prefer at least one short, low-energy task early to build momentum.",
  "response": [
    {
      "id": "t_weekly_email",
      "priority_score": 90,
      "bucket": "Now",
      "rationale": "Due today 16:00; low effort; good low-energy starter to build momentum."
    },
    {
      "id": "t_email_brian",
      "priority_score": 87,
      "bucket": "Now",
      "rationale": "Due tomorrow; unblocker for permit package; 30 min fits current free window."
    },
    {
      "id": "t_review_rdr",
      "priority_score": 74,
      "bucket": "Next",
      "rationale": "Due in two days; medium effort; schedule after email tasks."
    },
    {
      "id": "t_helical_calc",
      "priority_score": 62,
      "bucket": "Later",
      "rationale": "Larger high-energy block needed; due end of week; avoid overloading today."
    }
  ],
  "focus_queue_summary": {
    "planned_minutes_now": 60,
    "remaining_capacity_minutes": 180,
    "alternates": ["t_review_rdr"]
  }
}
