{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageItemResponse",
  "type": "object",
  "required": ["summary", "include_in_meeting", "include_reason", "agenda_section", "topics", "decisions", "open_questions", "dates", "actions", "project_guess"],
  "properties": {
    "summary": { "type": "string", "maxLength": 600 },
    "include_in_meeting": { "type": "boolean" },
    "include_reason": { "type": "string", "maxLength": 300 },
    "agenda_section": { "type": ["string", "null"], "maxLength": 120 },
    "topics": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 8 },
    "decisions": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 10 },
    "open_questions": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 10 },
    "dates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["label", "date"],
        "properties": {
          "label": { "type": "string", "maxLength": 120 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["title", "owner", "court", "due_at", "follow_up_by"],
        "properties": {
          "title": { "type": "string", "maxLength": 200 },
          "owner": { "type": ["string", "null"], "maxLength": 80 },
          "court": { "type": "string", "enum": ["mine", "theirs", "team"] },
          "due_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "follow_up_by": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "additionalProperties": false
      }
    },
    "project_guess": { "type": ["string", "null"], "maxLength": 80 }
  },
  "additionalProperties": false
}
