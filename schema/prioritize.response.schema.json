{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tidy.app/schema/prioritize.response.schema.json",
  "title": "PrioritizeResponse",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "priority_score", "bucket", "rationale"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "description": "Task ID" },
      "priority_score": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "Computed score used for ordering (0–100)"
      },
      "bucket": {
        "type": "string",
        "enum": ["Now", "Next", "Later", "Backlog"],
        "description": "Display label (TitleCase) returned by the model"
      },
      "rationale": {
        "type": "string",
        "minLength": 1,
        "description": "Short explanation of why the task landed here"
      }
    }
  },
  "examples": [
    [
      {
        "id": "t_weekly_email",
        "priority_score": 90,
        "bucket": "Now",
        "rationale": "Due today 16:00; low effort; momentum starter."
      },
      {
        "id": "t_email_brian",
        "priority_score": 87,
        "bucket": "Now",
        "rationale": "Due tomorrow; unblocker; fits 30-min window."
      },
      {
        "id": "t_review_rdr",
        "priority_score": 74,
        "bucket": "Next",
        "rationale": "Due in two days; schedule after emails."
      },
      {
        "id": "t_helical_calc",
        "priority_score": 62,
        "bucket": "Later",
        "rationale": "High-energy 120-min block; not needed today."
      }
    ]
  ]
}
