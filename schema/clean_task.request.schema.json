{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tidy.app/schema/clean_task.request.schema.json",
  "title": "CleanTaskRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["raw_text"],
  "properties": {
    "raw_text": {
      "type": "string",
      "minLength": 1,
      "description": "User's messy task input, e.g. 'email brian about easement before Friday 30 min'"
    },
    "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Base date for relative parsing (YYYY-MM-DD). Defaults to system date."
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone identifier (e.g., America/Chicago). Used for parsing dates."
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["emails", "phones", "proper_names"]
          },
          "uniqueItems": true,
          "default": ["emails", "phones", "proper_names"]
        }
      },
      "default": {
        "enabled": true,
        "entities": ["emails", "phones", "proper_names"]
      },
      "description": "Configuration for redacting sensitive data before sending to the AI model."
    }
  },
  "examples": [
    {
      "raw_text": "email brian about easement before Friday 30 min, attach grading sketch",
      "today": "2025-10-30",
      "timezone": "America/Chicago",
      "redaction": {
        "enabled": true,
        "entities": ["emails", "phones", "proper_names"]
      }
    }
  ]
}
