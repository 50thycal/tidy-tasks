{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tidy.app/schema/prioritize.request.schema.json",
  "title": "PrioritizeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "tasks"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Planning date in YYYY-MM-DD (local to timezone)."
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone (e.g., America/Phoenix). Defaults to app setting if omitted."
    },
    "energy": {
      "type": "string",
      "enum": ["low", "med", "high"],
      "description": "User's current energy setting for the day (optional)."
    },
    "max_focus_minutes": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600,
      "default": 240,
      "description": "Cap for total 'Now' bucket planned time (minutes)."
    },
    "calendar_windows": {
      "type": "array",
      "description": "Optional free/busy windows for the day to help fit tasks.",
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "additionalProperties": false,
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "type": { "type": "string", "enum": ["free", "busy"], "default": "free" }
        }
      },
      "default": []
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["inbox", "active", "done", "snoozed"] },
          "importance": { "type": "integer", "minimum": 0, "maximum": 100 },
          "effort_min": { "type": "integer", "enum": [5, 15, 30, 60, 120] },
          "energy": { "type": "string", "enum": ["low", "med", "high"] },
          "due_at": { "type": ["string", "null"], "format": "date-time" },
          "scheduled_for": { "type": ["string", "null"], "format": "date-time" },
          "project": { "type": ["string", "null"] },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "examples": [
    {
      "date": "2025-11-03",
      "timezone": "America/Phoenix",
      "energy": "med",
      "max_focus_minutes": 240,
      "calendar_windows": [
        { "start": "2025-11-03T09:00:00-07:00", "end": "2025-11-03T11:30:00-07:00", "type": "free" },
        { "start": "2025-11-03T13:30:00-07:00", "end": "2025-11-03T16:00:00-07:00", "type": "free" }
      ],
      "tasks": [
        {
          "id": "t_weekly_email",
          "title": "Prep weekly progress email",
          "status": "active",
          "importance": 60,
          "effort_min": 30,
          "energy": "low",
          "due_at": "2025-11-03T16:00:00-07:00",
          "project": "Account Ops",
          "tags": ["email", "report"]
        },
        {
          "id": "t_email_brian",
          "title": "Email Brian about easement language",
          "status": "active",
          "importance": 78,
          "effort_min": 30,
          "energy": "low",
          "due_at": "2025-11-04T17:00:00-07:00",
          "project": "Shawnee-Walker Segment 1",
          "tags": ["email", "client", "easement"]
        }
      ]
    }
  ]
}
