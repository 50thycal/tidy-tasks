{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParseEmailRequest",
  "type": "object",
  "required": ["email_text"],
  "properties": {
    "email_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
